#!name=YouTube去广告[墨鱼规则移植]
#!desc=youtubei / youtubei-att 用 Maasea 响应脚本（本仓库修补版：去首页赞助卡片，见 scripts/patch_youtube.py）；googlevideo 不做 MITM，视频流直接转发

# googlevideo 不进 MITM：解密视频流会拖慢播放，并占用 iOS 网络扩展约 50 MiB 的内存预算，
# 挤掉 get_watch 脚本（内存不足时整段响应被跳过，片头广告随之漏出）。
# 原先依赖 googlevideo MITM 的 &ctier 改写与 initplayback &oad 本地应答随之删除；片头广告由 get_watch/player 脚本处理。

[Map Local]
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads data-type=text data="" status-code=200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) data-type=text data="" status-code=200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext data-type=text data="" status-code=200

[Script]
youtube.response = type=http-response,pattern=^https:\/\/youtubei(-att)?\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch),requires-body=1,max-size=-1,binary-body-mode=1,timeout=30,script-path=https://raw.githubusercontent.com/LucionDong/clash-patches/main/dist/youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":false}"

[MITM]
hostname = %APPEND% www.youtube.com, s.youtube.com, youtubei.googleapis.com, youtubei-att.googleapis.com
