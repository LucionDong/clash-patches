#!name = B站去广告[Clash版]
#!version = 0.7.5
#!desc = 哔哩哔哩：去广告\n自定义去除APP内界面元素
#!author = ClydeTime[https://github.com/ClydeTime],VirgilClyne[https://github.com/VirgilClyne],app2smile[https://github.com/app2smile],RuCu6[https://github.com/RuCu6],Maasea[https://github.com/Maasea]
#!homepage = https://biliverse.github.io/guide/ad-block
#!icon = https://github.com/Biliverse/ADBlock/raw/main/src/assets/icon_rounded.png
#!category = 🪐 Biliverse
#!date = 2026-10-17 17:08:28
#!version = 0.7.5

[Map Local]
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/ADBlock(?:\?.*)?$ data-type=file data="https://github.com/Biliverse/ADBlock/releases/download/v0.7.5/BiliBili.ADBlock.boxjs.json" status-code=200 header="Content-Type:application/json; charset=utf-8|Cache-Control:no-store|X-PreferencePanes-Version:0.7.5"
# 去除默认搜索词：最小合法空 gRPC 帧
^https?:\/\/(grpc\.biliapi\.net|app\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ data-type=base64 data="AAAAAAA=" status-code=200 header="Content-Type:application/grpc|Content-Length:5|grpc-status:0"
# 去除搜索中的大家都在搜
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words data-type=text data="{}" header="application/json"
# 去除动态中的话题
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr data-type=text data="{}" header="application/json"
# 去除动态中的最常访问
^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist data-type=text data="{}" header="application/json"
# BiliBili漫画去广告
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash data-type=text data="{}" header="application/json"
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash data-type=text data="{}" header="application/json"
^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? data-type=text data="{}" header="application/json"
# 番剧页可能弹出的HTML广告
^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? header="content-type: application/json" data-type=text data="{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}"

[Body Rewrite]
# iPad端番剧推荐列表上方广告
http-response-jq ^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? 'del(.data.payment)'

[Script]
📺 BiliBili.ADBlock.feed.index.request.json = type=http-request,pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/feed\/index\?, script-path=https://raw.githubusercontent.com/LucionDong/clash-patches/main/dist/biliverse/ADBlock_request.bundle.js, argument=Splash="true"&Feed.AD="true"&Feed.Activity="false"&Feed.Vertical="false"&Feed.BlockUpLiveList=""&Feed.Story="true"&Feed.StoryCommercial="true"&Search.AD="true"&Search.Tracking="false"&Search.HotSearch="true"&PGC.AD="true"&Xlive.AD="true"&Xlive.RemoveTrackingCallbacks="false"&Xlive.RemovePreloadTracking="false"&Dynamic.HotTopics="true"&Dynamic.MostVisited="false"&Dynamic.MostVisitedLiveOnly="false"&Dynamic.AdCard="true"&Dynamic.PersonalAdCard="false"&View.AD="true"&DM.Command="false"&DM.Colorful="false"&DM.Airborne="false"&Reply.AD="false"&Reply.CommercialLinks="false"&Reply.SubjectDescriptionCommercial="false"&Privacy.Tracking="true"&Privacy.BlockBiliCommercial="false"&Privacy.BlockThirdParty="false"&Privacy.Strict="false"&Storage="Argument"&LogLevel="WARN"
